[user]
    name = Pranav Laxman
    email = plaxman81@gmail.com
[init]
    defaultBranch = main
[core]
    editor = nvim
    autocrlf = input
[push]
    autoSetupRemote = true
[rerere]
    enabled = true
[merge]
    tool = nvimdiff1
[status]
    submodulesummary = true
[diff]
    submodule = log
    colorMoved = default
[rebase]
    autostash = true
[alias]
    rc = rebase --continue
    ra = rebase --abort
    mc = merge --continue
    ma = merge --abort
    mt = mergetool
[advice]
    mergeConflict = false
    skippedCherryPicks = false
