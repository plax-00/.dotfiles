layout {
    default_tab_template {
        children
        pane size=1 borderless=true {
            plugin location="compact-bar"
        }
    }
    tab name="editor" focus=true {
        pane focus=true command="nvim"
    }
    tab name="shell" {
        pane split_direction="vertical" {
            pane
            pane {
                pane command="cargo" start_suspended=true {
                    args "run" "--quiet"
                }
                pane command="cargo" start_suspended=true {
                    args "test"
                }
            }
        }
    }
}
