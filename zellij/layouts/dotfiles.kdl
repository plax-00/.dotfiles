layout {
    cwd "~/.dotfiles"
    default_tab_template {
        children
        pane size=1 borderless=true {
            plugin location="compact-bar"
        }
    }
    tab name="editor" focus=true {
        pane focus=true command="nvim"
    }
    tab name="shell" {
        pane
    }
    tab name="lazygit" {
        pane command="lazygit"
    }
}
